# ── Carga (requisições/s por rota). Ajuste ao vivo e rode `make load` de novo. ──
RATE_PRODUCTS=60
RATE_CREATE_ORDER=25
RATE_GET_ORDER=13
RATE_REPORT=2
# Fases do teste
BASELINE_DURATION=30s
LOAD_DURATION=150s
# Teto de VUs por cenário (memória do k6). Com fila infinita cada requisição presa ocupa um VU.
MAX_VUS=4000

# ── Banco ──
# CPUs do Postgres. Um banco pequeno (2 vCPU) é o que torna a cascata reproduzível.
PG_CPUS=2
# Volume do seed (só vale num banco recém-criado: `make reset`)
SEED_ORDERS=3000000
SEED_PADDING=2

# ── Portas no host ──
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
